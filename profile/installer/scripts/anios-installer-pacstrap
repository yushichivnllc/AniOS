#!/usr/bin/env bash
# Install the curated official-repository AniOS target set into Calamares' mount.
set -Eeuo pipefail

TARGET_ROOT="${1:-}"
MANIFEST="${ANIOS_TARGET_MANIFEST:-/usr/share/anios/installer/packages.x86_64}"
PACMAN_CONF="${ANIOS_LIVE_PACMAN_CONF:-/etc/pacman.conf}"

fail() { echo "AniOS installer: $*" >&2; exit 1; }

[[ $EUID -eq 0 ]] || fail "pacstrap must run as root"
[[ -n "$TARGET_ROOT" && "$TARGET_ROOT" == /* && "$TARGET_ROOT" != / ]] ||
  fail "invalid target root"
[[ -d "$TARGET_ROOT" ]] || fail "target root does not exist: $TARGET_ROOT"
command -v mountpoint >/dev/null 2>&1 || fail "mountpoint is missing"
command -v pacstrap >/dev/null 2>&1 || fail "pacstrap is missing from the Live ISO"
[[ -s "$MANIFEST" ]] || fail "target package manifest is missing: $MANIFEST"
[[ -s "$PACMAN_CONF" ]] || fail "Live pacman.conf is missing: $PACMAN_CONF"

# A bad Global Storage value must never turn the live root into the pacstrap
# target. Calamares mounts the selected root at a dedicated mount point first.
target_real="$(realpath -e -- "$TARGET_ROOT")" || fail "cannot resolve target root"
[[ "$target_real" != / && "$target_real" != /run/archiso* ]] ||
  fail "refusing to install into the Live system"
mountpoint -q -- "$target_real" || fail "target root is not mounted"

packages=()
while IFS= read -r line || [[ -n "$line" ]]; do
  line="${line%%#*}"
  line="${line#"${line%%[![:space:]]*}"}"
  line="${line%"${line##*[![:space:]]}"}"
  [[ -n "$line" ]] || continue
  [[ "$line" =~ ^[A-Za-z0-9@._+-]+$ ]] || fail "invalid package name in manifest: $line"
  packages+=("$line")
done <"$MANIFEST"

(( ${#packages[@]} > 0 )) || fail "target package manifest is empty"

# Steam, Wine and other 32-bit target packages must resolve from multilib on
# the Live pacman config. build-iso.sh enables that repository for both roots.
if grep -qxF 'lib32-mesa' "$MANIFEST" &&
  ! grep -qE '^[[:space:]]*\[multilib\][[:space:]]*$' "$PACMAN_CONF"; then
  fail "multilib is disabled in the Live pacman.conf"
fi

# Driver NVIDIA 580xx không có trong kho chính thức: pacstrap chỉ cài được nó từ kho
# file cục bộ [anios-aur] của ảnh. Thiếu kho thì dừng ngay với thông báo rõ ràng,
# thay vì để pacstrap báo "target not found" giữa chừng.
if grep -qxF 'nvidia-580xx-dkms' "$MANIFEST"; then
  AUR_REPO_DIR="${ANIOS_LIVE_AUR_REPO:-/usr/share/anios/aur-repo}"
  [[ -s "$AUR_REPO_DIR/anios-aur.db.tar.gz" ]] ||
    fail "thiếu kho [anios-aur] của ảnh live ($AUR_REPO_DIR): không có driver NVIDIA 580xx để cài"
  grep -qxF '[anios-aur]' "$PACMAN_CONF" ||
    grep -qE '^[[:space:]]*\[anios-aur\][[:space:]]*$' "$PACMAN_CONF" ||
    fail "pacman.conf của ảnh live không khai báo kho [anios-aur]"
fi

# Lúc khởi động, phiên live tự tinh chỉnh /etc/pacman.conf để khỏi đầy tmpfs
# cowspace: CacheDir trên /tmp, IgnorePkg bỏ qua kernel/firmware của phiên live
# và NoExtract bỏ man page, /usr/share/doc, /usr/share/help, /usr/share/info và
# mọi locale ngoài en/vi (xem anios-live-home.service và anios-update).
#
# pacstrap đọc CHÍNH file cấu hình đó (-C "$PACMAN_CONF"), nên nếu dùng nguyên
# thì máy vừa cài sẽ không có man page, không có tài liệu và mất hết locale
# không phải en/vi — đúng cho một phiên live sống trong RAM, sai cho một hệ
# thống nằm trên đĩa. Dựng một bản sao đã lọc riêng cho bước cài: giữ nguyên
# mọi kho (multilib và kho file [anios-aur] chứa driver NVIDIA 580xx), chỉ bỏ
# ba dòng tinh chỉnh của phiên live. CacheDir không cần giữ vì pacstrap luôn
# truyền --cachedir của riêng nó.
install_conf="$(mktemp "${TMPDIR:-/tmp}/anios-installer-pacman.XXXXXX")"
trap 'rm -f -- "$install_conf"' EXIT
awk '
  /^[[:space:]]*#[[:space:]]*anios-live-pacman-tuning[[:space:]]*$/ { next }
  /^[[:space:]]*\[/ {
    in_options = ($0 ~ /^[[:space:]]*\[options\][[:space:]]*$/)
    print
    next
  }
  in_options && /^[[:space:]]*(CacheDir|IgnorePkg|IgnoreGroup|NoExtract)[[:space:]]*=/ { next }
  { print }
' "$PACMAN_CONF" >"$install_conf"
[[ -s "$install_conf" ]] || fail "could not prepare the pacman configuration for pacstrap"
grep -qE '^[[:space:]]*\[' "$install_conf" ||
  fail "the pacman configuration for pacstrap lost every repository"

printf 'AniOS installer: pacstrap %s with %d curated packages\n' "$target_real" "${#packages[@]}"
pacstrap -K -C "$install_conf" "$target_real" "${packages[@]}"

[[ -x "$target_real/usr/bin/pacman" ]] || fail "pacstrap returned successfully but target pacman is missing"
printf 'AniOS installer: target packages installed successfully\n'
