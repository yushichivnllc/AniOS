# Curated installed-system manifest for Calamares' pacstrap step.
# Keep this separate from profile/packages.x86_64: that file is the Live ISO,
# with its Live-session packages and an intentionally larger recovery/AI stack.
# Target uses the same official AniOS desktop/gaming/AI package set plus a real
# Arch base, firmware, GRUB, storage/encryption tools and dual-boot detection.
# AUR apps (including Calamares, yay, browsers and GUI AI bundles) are excluded.
base
linux-firmware
sudo
efibootmgr
os-prober
cryptsetup
lvm2
btrfs-progs
linux-zen
grub
shadow
linux-zen-headers
intel-ucode
amd-ucode
archlinux-keyring
hyprland
sddm
xdg-desktop-portal
xdg-desktop-portal-hyprland
xdg-desktop-portal-gtk
waybar
foot
fuzzel
mako
swaybg
hyprlock
thunar
thunar-volman
file-roller
xdg-user-dirs
xdg-utils
polkit-gnome
gnome-disk-utility
noto-fonts
noto-fonts-emoji
ttf-dejavu
ttf-nerd-fonts-symbols
ibus
ibus-unikey
fcitx5
fcitx5-unikey
fcitx5-configtool
fcitx5-gtk
fcitx5-qt
udisks2
gvfs
gvfs-mtp
ntfs-3g
exfatprogs
dosfstools
zram-generator
networkmanager
network-manager-applet
wpa_supplicant
bluez
bluez-utils
pipewire
pipewire-audio
pipewire-alsa
pipewire-pulse
wireplumber
alsa-utils
libpulse
rtkit
pavucontrol
sof-firmware
steam

# GPU NVIDIA: driver nvidia-580xx (proprietary). Các gói này được dựng từ AUR lúc
# dựng ISO và đưa vào kho file cục bộ [anios-aur] của ảnh (xem
# profile/packages.aur.x86_64); pacstrap của bộ cài đặt đọc kho đó nên driver được
# cài lên ổ đích. nvidia-580xx-dkms là gói tách của PackageBase nvidia-580xx-utils
# và biên dịch module kernel cho linux-zen (có linux-zen-headers ở trên).
nvidia-580xx-utils
lib32-nvidia-580xx-utils
nvidia-580xx-settings
nvidia-580xx-dkms
egl-wayland

