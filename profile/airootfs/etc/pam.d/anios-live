# PAM service chỉ dùng cho màn hình khoá của phiên live AniOS (hyprlock).
# Dùng mật khẩu của tài khoản live thay vì pam_permit để màn hình khoá và sudo
# cùng xác thực bằng mật khẩu AniOS được đặt lúc khởi động.
#
# Dùng pam_unix trực tiếp để tránh pam_faillock của system-auth khoá tài khoản
# live tạm thời sau vài lần nhập sai. Đây vẫn là môi trường live, không phải
# cấu hình PAM để sao chép sang hệ thống đã cài lên ổ đĩa.
auth      required pam_unix.so
account   required pam_unix.so
