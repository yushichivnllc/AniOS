[Unit]
Description=Prepare AniOS live user configuration
After=systemd-sysusers.service systemd-tmpfiles-setup.service
Before=sddm.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/anios/live-home-setup
RemainAfterExit=yes
# Thư viện Steam lớn khiến việc chuẩn bị home mất nhiều thời gian hơn 45s mặc định
# của DefaultTimeoutStartSec; khi đó systemd sẽ dừng giữa chừng.
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
