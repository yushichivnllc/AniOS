[Unit]
Description=Quit Steam cleanly before the AniOS system shuts down
Documentation=file:///usr/local/bin/anios-steam-quit
DefaultDependencies=no
Before=shutdown.target umount.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=/usr/local/bin/anios-steam-quit
# Phải lớn hơn thời gian chờ trong script (45s) cộng thời gian sync.
TimeoutStopSec=70s

[Install]
WantedBy=multi-user.target
