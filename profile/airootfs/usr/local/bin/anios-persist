#!/usr/bin/env bash
# anios-persist — dùng phần dung lượng CÒN LẠI của USB làm ổ lưu dữ liệu cho AniOS Live.
#
# Vì sao cần: ISO ghi ra USB chỉ chiếm phần đầu đĩa (vài GB, chỉ đọc). Mặc định cả hệ
# thống live chạy trên lớp ghi nằm trong RAM (tmpfs), nên USB 64 GB vẫn chỉ cho bạn
# khoảng 7–10 GB "trống" (tuỳ RAM) và mọi thứ cài thêm mất sạch khi tắt máy.
#
# Script này tạo một phân vùng ext4 nhãn ANIOS_PERSIST trên toàn bộ phần đĩa chưa dùng.
# Lần boot sau, menu khởi động tự dùng phân vùng đó làm lớp ghi (cow_label=ANIOS_PERSIST):
# dung lượng trống của `/` bằng dung lượng phân vùng, còn gói đã cài và dữ liệu được giữ lại.
#
# Cách dùng:
#   anios-persist            xem trạng thái (mặc định)
#   anios-persist setup      tạo phân vùng lưu trữ trên phần trống của USB (hỏi xác nhận)
#   anios-persist setup -y   như trên, không hỏi
set -Eeuo pipefail

LABEL=ANIOS_PERSIST
MIN_FREE_MIB=2048

die() { echo "Lỗi: $*" >&2; exit 1; }

# Đĩa chứa ISO đang chạy. Với copytoram, /run/archiso/bootmnt đã bị gỡ nên phải tra
# lại theo UUID/nhãn mà bootloader truyền cho kernel.
find_boot_partition() {
  local part="" arg uuid="" label=""
  part="$(findmnt -rno SOURCE /run/archiso/bootmnt 2>/dev/null || true)"
  if [[ -z "$part" ]]; then
    for arg in $(</proc/cmdline); do
      case "$arg" in
        archisosearchuuid=*) uuid="${arg#*=}" ;;
        archisolabel=*)      label="${arg#*=}" ;;
      esac
    done
    [[ -n "$uuid"  ]] && part="$(blkid -U "$uuid"  2>/dev/null || true)"
    [[ -z "$part" && -n "$label" ]] && part="$(blkid -L "$label" 2>/dev/null || true)"
  fi
  [[ -b "$part" ]] || return 1
  printf '%s\n' "$part"
}

# In ra đường dẫn đĩa cha của một phân vùng.
parent_disk() {
  local pk
  pk="$(lsblk -dno PKNAME "$1" 2>/dev/null | head -n1)"
  [[ -n "$pk" ]] || return 1
  printf '/dev/%s\n' "$pk"
}

# Sector (512 B) cuối cùng đã bị phân vùng chiếm trên đĩa $1.
last_used_sector() {
  local disk="$1" part name start size end max=0
  while read -r part; do
    [[ "$part" == "$disk" ]] && continue
    name="${part##*/}"
    [[ -r "/sys/class/block/$name/start" ]] || continue
    start="$(<"/sys/class/block/$name/start")"
    size="$(<"/sys/class/block/$name/size")"
    end=$(( start + size ))
    (( end > max )) && max=$end
  done < <(lsblk -rnpo NAME "$disk")
  echo "$max"
}

free_mib_after_partitions() {
  local disk="$1" total_sectors used
  total_sectors="$(( $(blockdev --getsize64 "$disk") / 512 ))"
  used="$(last_used_sector "$disk")"
  # Chừa 2048 sector (1 MiB) cho căn lề và bảng GPT dự phòng ở cuối đĩa.
  echo $(( (total_sectors - used - 2048) / 2048 ))
}

show_status() {
  local part disk free_mib
  echo "== Lớp ghi của hệ thống live"
  if findmnt -rn /run/archiso/cowspace >/dev/null 2>&1; then
    printf '   Kiểu lưu trữ : %s\n' "$(findmnt -rno FSTYPE /run/archiso/cowspace)"
    if [[ "$(findmnt -rno FSTYPE /run/archiso/cowspace)" == tmpfs ]]; then
      echo "   Đang chạy hoàn toàn trong RAM: dung lượng bị giới hạn và mất khi tắt máy."
    else
      echo "   Đang dùng ổ lưu trữ trên USB: dữ liệu được giữ lại giữa các lần boot."
    fi
  else
    echo "   (không phải phiên live của Archiso)"
  fi
  df -h / | sed 's/^/   /'
  echo
  echo "== USB khởi động"
  if ! part="$(find_boot_partition)"; then
    echo "   Không xác định được thiết bị chứa ISO."
    return 0
  fi
  if ! disk="$(parent_disk "$part")"; then
    echo "   $part không nằm trên đĩa có bảng phân vùng."
    return 0
  fi
  lsblk -o NAME,SIZE,FSTYPE,LABEL,MOUNTPOINTS "$disk" | sed 's/^/   /'
  free_mib="$(free_mib_after_partitions "$disk")"
  echo
  if blkid -L "$LABEL" >/dev/null 2>&1; then
    echo "   Đã có phân vùng $LABEL ($(blkid -L "$LABEL"))."
  elif (( free_mib >= MIN_FREE_MIB )); then
    printf '   Còn %s GiB chưa dùng trên %s. Chạy: anios-persist setup\n' "$(( free_mib / 1024 ))" "$disk"
  else
    echo "   Không còn đủ chỗ trống chưa phân vùng trên $disk."
  fi
}

do_setup() {
  local assume_yes=0 part disk free_mib answer newpart dump before_list
  [[ "${1:-}" == -y || "${1:-}" == --yes ]] && assume_yes=1

  if (( EUID != 0 )); then
    exec sudo -- "$0" setup "$@"
  fi

  part="$(find_boot_partition)" || die "không tìm thấy USB đang chứa AniOS (có đang boot từ DVD/mạng không?)."
  [[ "$part" != /dev/sr* ]] || die "đang boot từ đĩa quang; không có chỗ để lưu dữ liệu."
  disk="$(parent_disk "$part")" || die "$part không nằm trên đĩa có bảng phân vùng."

  if blkid -L "$LABEL" >/dev/null 2>&1; then
    die "đã có phân vùng $LABEL ($(blkid -L "$LABEL")). Khởi động lại và chọn mục AniOS Live trong menu."
  fi

  free_mib="$(free_mib_after_partitions "$disk")"
  (( free_mib >= MIN_FREE_MIB )) ||
    die "$disk chỉ còn ${free_mib} MiB chưa phân vùng (cần ít nhất ${MIN_FREE_MIB} MiB)."

  echo "Sẽ tạo phân vùng ext4 nhãn $LABEL trên $disk, dung lượng khoảng $(( free_mib / 1024 )) GiB"
  echo "(toàn bộ phần chưa dùng sau ảnh ISO). Các phân vùng đang có KHÔNG bị thay đổi."
  if (( ! assume_yes )); then
    read -rp "Tiếp tục? [y/N] " answer
    [[ "$answer" =~ ^[yY] ]] || { echo "Đã huỷ."; exit 0; }
  fi

  before_list="$(lsblk -rnpo NAME "$disk")"
  # --append: chỉ thêm phân vùng mới vào chỗ trống đầu tiên, giữ nguyên phần còn lại.
  echo ',,L' | sfdisk --append --quiet --no-reread "$disk" || die "sfdisk không thêm được phân vùng."
  udevadm settle 2>/dev/null || true
  partx -a "$disk" 2>/dev/null || partx -u "$disk" 2>/dev/null || partprobe "$disk" 2>/dev/null || true

  # Phân vùng mới là phân vùng có sector bắt đầu lớn nhất trong bảng.
  dump="$(sfdisk -d "$disk")"
  newpart="$(sed -nE 's/^(\S+) : start= *([0-9]+),.*/\2 \1/p' <<<"$dump" | sort -n | tail -n1 | cut -d' ' -f2)"
  [[ -n "$newpart" ]] || die "không xác định được phân vùng vừa tạo."
  grep -qxF "$newpart" <<<"$before_list" && die "$newpart đã tồn tại từ trước; dừng lại để không ghi đè dữ liệu."
  for _ in $(seq 1 20); do
    [[ -b "$newpart" ]] && break
    sleep 0.5
  done
  [[ -b "$newpart" ]] || die "kernel chưa nhận phân vùng $newpart; hãy rút/cắm lại USB rồi chạy lại (phân vùng đã được tạo)."

  wipefs -a "$newpart" >/dev/null 2>&1 || true
  # -m 0: không để dành 5% cho root vì đây là ổ dữ liệu của phiên live.
  mkfs.ext4 -F -q -L "$LABEL" -m 0 -E lazy_itable_init=1,lazy_journal_init=1 "$newpart"
  udevadm settle 2>/dev/null || true

  cat <<EOF

Xong: $newpart (nhãn $LABEL) đã sẵn sàng.
Khởi động lại máy. Ở menu GRUB (UEFI) AniOS tự phát hiện phân vùng này và bật lưu trữ;
ở chế độ BIOS hãy chọn mục "AniOS Live (BIOS, có ổ lưu dữ liệu)".
Sau đó chạy 'df -h /' để thấy dung lượng trống đã bằng cả phần còn lại của USB.
EOF
}

case "${1:-status}" in
  status|-s|--status) show_status ;;
  setup|create)       shift; do_setup "$@" ;;
  -h|--help|help)     sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//' ;;
  *)                  die "lệnh không hợp lệ: $1 (dùng: status | setup [-y])" ;;
esac
