#!/usr/bin/env bash
# First-boot GUI entry point: choose an AniOS-family mode from the Live desktop.
set -Eeuo pipefail

chooser_ui="${ANIOS_BOOT_CHOICE_QML:-/usr/share/anios/boot-choice.qml}"
qml_bin="${ANIOS_QML_BIN:-}"
if [[ -z "$qml_bin" ]]; then
  qml_bin="$(command -v qml6 2>/dev/null || command -v qml 2>/dev/null || true)"
fi
choice=""
proc_cmdline="${ANIOS_PROC_CMDLINE:-/proc/cmdline}"
tails_launcher="${ANIOS_TAILS_BIN:-/usr/local/bin/anios-tails}"
anix_launcher="${ANIOS_ANIX_BIN:-/usr/local/bin/anix}"

# Use the Material-styled QML chooser in the normal Live desktop. KDialog remains a
# compatibility fallback for images where the QML runtime or Material module cannot start.
if [[ -n "$qml_bin" ]] && command -v "$qml_bin" >/dev/null 2>&1 && [[ -s "$chooser_ui" ]]; then
  qml_status=0
  if chooser_output="$(QT_QUICK_CONTROLS_STYLE=Material \
    QT_QUICK_CONTROLS_MATERIAL_THEME=Dark \
    QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland}" \
    "$qml_bin" "$chooser_ui" 2>&1)"; then
    choice="$(printf '%s\n' "$chooser_output" |
      sed -nE 's/.*ANIOS_BOOT_CHOICE=(anios|anitails|anix).*/\1/p' | tail -n 1)"
    if [[ -z "$choice" ]] && ! grep -qF 'ANIOS_BOOT_CHOICE_READY=1' <<<"$chooser_output"; then
      qml_status=1
    fi
  else
    qml_status=$?
  fi

  if (( qml_status != 0 )); then
    launch_log="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/anios-boot-choice-qml.log"
    printf '%s\n' "$chooser_output" >"$launch_log" 2>/dev/null || true
    printf 'AniOS: Material chooser failed (status %s); details: %s\n' \
      "$qml_status" "$launch_log" >&2
  elif [[ -z "$choice" ]]; then
    # The QML window was shown and then closed without a mode selection.
    exit 0
  fi
fi

if [[ -z "$choice" ]]; then
  command -v kdialog >/dev/null 2>&1 || exit 0
  choice="$(kdialog --title "Welcome to AniOS" --default anios --menu \
    "AniTails boots with Tor-only networking; Anix uses isolated Whonix VMs that must be imported and configured first." \
    anios "AniOS thường — continue to AniOS Live" \
    anitails "AniTails — Tor-only Live (reboot required)" \
    anix "Anix — Whonix Gateway + Workstation VMs")" || exit 0
fi

case "$choice" in
  anios)
    if grep -qw 'anios_mode=anitails' "$proc_cmdline" && command -v kdialog >/dev/null 2>&1; then
      kdialog --title "AniTails" --msgbox \
        "AniTails đang bật kill switch Tor-only. Chọn AniOS thường cần khởi động lại và boot mục AniOS Live thường trong GRUB/Syslinux."
    fi
    exit 0
    ;;
  anitails)
    if grep -qw 'anios_mode=anitails' "$proc_cmdline"; then
      exec "$tails_launcher"
    fi
    if command -v kdialog >/dev/null 2>&1 && kdialog --title "AniTails" --yesno \
      "AniTails needs to start from its protected boot entry so the Tor firewall is active before networking. Reboot now, then choose ‘AniTails — Tor-only live mode’ in GRUB/Syslinux?"; then
      systemctl reboot
    fi
    ;;
  anix)
    exec "$anix_launcher"
    ;;
  *)
    exit 0
    ;;
esac
