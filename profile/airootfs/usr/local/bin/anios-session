#!/usr/bin/env bash
set -euo pipefail

# Phiên AniOS chạy qua dbus-run-session để Wayland portal, tray và fcitx5 có
# một D-Bus riêng cho tài khoản live.
#
# Biến môi trường bộ gõ được đặt ở đây (không đặt trong /etc/environment) để
# chỉ ảnh hưởng tới phiên đăng nhập của người dùng: greeter của SDDM chạy dưới
# tài khoản `sddm` và không nên nạp module nhập liệu của fcitx5.
export GTK_IM_MODULE=fcitx
export QT_IM_MODULE=fcitx
export XMODIFIERS=@im=fcitx
export SDL_IM_MODULE=fcitx

# The Live-only welcome/installer choice is gated by archiso's runtime mount.
# Installed sessions deliberately clear the marker and never prompt at login.
if [[ -d /run/archiso ]]; then
  export ANIOS_LIVE=1
else
  unset ANIOS_LIVE
fi

# Thông báo cho người dùng biết dữ liệu đang nằm trong RAM hay trên USB. Chạy nền và
# chờ Hyprland mở socket, rồi thoát; không chặn phiên và không chạy ngoài phiên live.
if [[ "${ANIOS_LIVE:-}" == 1 ]] && command -v anios-persist >/dev/null 2>&1; then
  (
    runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    for _ in $(seq 1 120); do
      sig="$(find "$runtime/hypr" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | head -n1 || true)"
      if [[ -n "$sig" ]] && HYPRLAND_INSTANCE_SIGNATURE="${sig##*/}" hyprctl version >/dev/null 2>&1; then
        HYPRLAND_INSTANCE_SIGNATURE="${sig##*/}" anios-persist notify
        exit 0
      fi
      sleep 1
    done
  ) >/dev/null 2>&1 &
fi

# Driver NVIDIA proprietary cần biến môi trường riêng (GBM, GLX, VA-API) trước khi
# Hyprland khởi tạo GPU. Không có card NVIDIA thì hàm này không đặt gì.
# shellcheck source=/dev/null
if [[ -r /usr/local/lib/anios/gpu-env.sh ]]; then
  . /usr/local/lib/anios/gpu-env.sh
  anios_export_gpu_env
fi

mode="${1:-}"
if [[ "$mode" == "--imi" || "$mode" == "imi" || "$mode" == "immaterial-impulse" ]]; then
  export ANIOS_DESKTOP="imi"
  shift || true
elif [[ "$mode" == "--minimal" || "$mode" == "minimal" ]]; then
  export ANIOS_DESKTOP="minimal"
  shift || true
fi

# Phiên "AniOS - Safe": tắt blur/shadow/animation và con trỏ phần cứng ngay từ cấu
# hình Hyprland (xem ~/.config/hypr/hyprland/nvidia.lua). Đây là đường vào desktop
# khi driver GPU mới làm compositor chết, và cũng là chế độ mà script này tự lùi về
# khi Hyprland thoát ngay sau khi khởi động (bên dưới).
if [[ "${1:-}" == "--safe" || "${1:-}" == "safe" ]]; then
  export ANIOS_SAFE=1
  shift || true
fi

# Nhật ký phiên: khi Hyprland không lên hình, người dùng chỉ còn TTY để xem
# `cat ~/.local/share/anios/session.log` hoặc chạy `anios-gpu-doctor`. Ghi cả hồ sơ
# GPU/modeset để câu "không vào được giao diện" có ngay dữ kiện chẩn đoán.
log_dir="${XDG_STATE_HOME:-${HOME:-/tmp}/.local/share}/anios"
log_file="$log_dir/session.log"
if mkdir -p -- "$log_dir" 2>/dev/null; then
  # Giữ nhật ký nhỏ: mỗi lần đăng nhập chỉ thêm vài dòng, nhưng máy quán net đăng
  # nhập hàng trăm lần mỗi ngày nên vẫn phải chặn phình to.
  if [[ -f "$log_file" ]] && (( $(stat -c %s -- "$log_file" 2>/dev/null || echo 0) > 262144 )); then
    tail -c 65536 -- "$log_file" >"$log_file.tmp" 2>/dev/null &&
      mv -f -- "$log_file.tmp" "$log_file" 2>/dev/null || true
  fi
  anios_log() {
    printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$*" >>"$log_file" 2>/dev/null || true
  }
else
  log_file=""
  anios_log() { :; }
fi
anios_log "session start: desktop=${ANIOS_DESKTOP:-default} safe=${ANIOS_SAFE:-0} gpu=${ANIOS_GPU:-none} nvidia_modeset=${ANIOS_NVIDIA_MODESET:-unknown}"

# Không dùng `exec`: cần đọc mã thoát của Hyprland để biết phiên có lên hình hay
# không, rồi ghi lại và (một lần) thử chế độ an toàn.
started_at="$(date +%s)"
status=0
set +e
dbus-run-session -- Hyprland "$@"
status=$?
set -euo pipefail
elapsed=$(( $(date +%s) - started_at ))
anios_log "Hyprland exited with status $status after ${elapsed}s"

# Hyprland chết trong vài giây đầu là dấu hiệu driver/hiệu ứng, không phải người
# dùng thoát (thoát bằng Super+Shift+E trả mã 0). Thử lại đúng một lần ở chế độ an
# toàn để người dùng vẫn có desktop, và ghi lý do vào nhật ký.
if (( status != 0 )) && [[ "${ANIOS_SAFE:-0}" != 1 ]] && (( elapsed < 20 )); then
  anios_log "retrying in safe mode after a fast failure"
  printf '%s\n' \
    "AniOS: Hyprland thoát với mã $status sau ${elapsed}s — thử lại ở chế độ an toàn." \
    "       Chi tiết: ${log_file:-~/.local/share/anios/session.log}" >&2
  export ANIOS_SAFE=1
  set +e
  dbus-run-session -- Hyprland "$@"
  status=$?
  set -euo pipefail
  anios_log "safe-mode Hyprland exited with status $status"
fi

exit "$status"
