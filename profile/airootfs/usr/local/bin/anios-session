#!/usr/bin/env bash
set -euo pipefail

# Phiên AniOS chạy qua dbus-run-session để Wayland portal, tray và fcitx5 có
# một D-Bus riêng cho tài khoản live.
#
# Biến môi trường bộ gõ được đặt ở đây (không đặt trong /etc/environment) để
# chỉ ảnh hưởng tới phiên đăng nhập của người dùng: greeter của SDDM chạy dưới
# tài khoản `sddm` và không nên nạp module nhập liệu của fcitx5.
export GTK_IM_MODULE=fcitx
export QT_IM_MODULE=fcitx
export XMODIFIERS=@im=fcitx
export SDL_IM_MODULE=fcitx

# The Live-only welcome/installer choice is gated by archiso's runtime mount.
# Installed sessions deliberately clear the marker and never prompt at login.
if [[ -d /run/archiso ]]; then
  export ANIOS_LIVE=1
else
  unset ANIOS_LIVE
fi

# Thông báo cho người dùng biết dữ liệu đang nằm trong RAM hay trên USB. Chạy nền và
# chờ Hyprland mở socket, rồi thoát; không chặn phiên và không chạy ngoài phiên live.
if [[ "${ANIOS_LIVE:-}" == 1 ]] && command -v anios-persist >/dev/null 2>&1; then
  (
    runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    for _ in $(seq 1 120); do
      sig="$(find "$runtime/hypr" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | head -n1 || true)"
      if [[ -n "$sig" ]] && HYPRLAND_INSTANCE_SIGNATURE="${sig##*/}" hyprctl version >/dev/null 2>&1; then
        HYPRLAND_INSTANCE_SIGNATURE="${sig##*/}" anios-persist notify
        exit 0
      fi
      sleep 1
    done
  ) >/dev/null 2>&1 &
fi

mode="${1:-}"
if [[ "$mode" == "--imi" || "$mode" == "imi" || "$mode" == "immaterial-impulse" ]]; then
  export ANIOS_DESKTOP="imi"
  shift || true
elif [[ "$mode" == "--minimal" || "$mode" == "minimal" ]]; then
  export ANIOS_DESKTOP="minimal"
  shift || true
fi

exec dbus-run-session -- Hyprland "$@"
