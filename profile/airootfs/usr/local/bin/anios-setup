#!/usr/bin/env bash
set -Eeuo pipefail

if (( EUID == 0 )); then
  echo "Do not run this installer as root; run it from the AniOS live user session." >&2
  exit 1
fi

echo "============================================================"
echo " AniOS — Immaterial Impulse Desktop (Quickshell + Hyprland)"
echo "============================================================"
echo "Bộ dotfile và thành phần Immaterial Impulse đã được CÀI SẴN"
echo "trong hệ thống AniOS (hoàn toàn offline, không cần tải thêm)."
echo

choice="${1:-}"
if [[ -z "$choice" ]]; then
  echo "Tuỳ chọn:"
  echo "  1) Chuyển ngay sang giao diện Immaterial Impulse (Quickshell)"
  echo "  2) Chuyển về giao diện AniOS Minimal (Waybar)"
  echo "  3) Xem trạng thái giao diện hiện tại"
  echo "  4) Khôi phục dotfile gốc từ /usr/share/anios/skel"
  echo "  5) Thoát"
  read -rp "Chọn [1-5] (mặc định 1): " sel
  sel="${sel:-1}"
else
  sel="$choice"
fi

case "$sel" in
  1|--imi|imi)
    /usr/local/bin/anios-switch-desktop imi
    ;;
  2|--minimal|minimal)
    /usr/local/bin/anios-switch-desktop minimal
    ;;
  3|--status|status)
    /usr/local/bin/anios-switch-desktop status
    ;;
  4|--reset|reset)
    echo "Đang khôi phục dotfile gốc từ /usr/share/anios/skel..."
    cp -r /usr/share/anios/skel/.config/quickshell "$HOME/.config/"
    cp -r /usr/share/anios/skel/.config/matugen "$HOME/.config/"
    cp -r /usr/share/anios/skel/.config/hypr "$HOME/.config/"
    /usr/local/bin/anios-switch-desktop imi
    echo "Khôi phục thành công!"
    ;;
  5|q|quit|exit)
    exit 0
    ;;
  *)
    echo "Lựa chọn không hợp lệ: $sel"
    exit 1
    ;;
esac
