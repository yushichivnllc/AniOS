#!/usr/bin/env bash
set -Eeuo pipefail

# Với tài khoản live, "sao chép skel nếu chưa có" của systemd-tmpfiles không đủ:
# overlay airootfs khiến /home và /etc vẫn là ảnh gốc, nên phải đồng bộ theo
# cách chỉ thêm file còn thiếu bằng rsync --ignore-existing. Nhờ vậy lần chạy
# sau chỉ bù các mục còn thiếu mà không ghi đè gì người dùng đã sửa.

user=anios
home="$(getent passwd "$user" | cut -d: -f6)"
[[ -n "$home" && "$home" == /home/* ]] || { echo "Cannot resolve the AniOS live user's home directory" >&2; exit 1; }
group="$(id -gn "$user")"
skel=/usr/share/anios/skel

install -d -m 0750 -o "$user" -g "$group" "$home"

# Kiểu dấu chấm để .config, .bashrc... nằm ngay trong $home chứ không sinh thư mục con.
if command -v rsync >/dev/null 2>&1; then
  rsync -a --ignore-existing "$skel/./" "$home/"
else
  cp -a -n "$skel/." "$home/"
fi

# Bản sao skel nằm trong ảnh nén của hệ thống live thuộc về root, mà ứng dụng
# trong phiên lại cần ghi vào ~/.config: chuyển toàn bộ home cho tài khoản live.
chown -R "$user:$group" "$home"

# Đặt mật khẩu dùng chung cho đăng nhập SDDM, mở khoá hyprlock và sudo.
# Đây là mật khẩu cố ý đơn giản cho tài khoản live tạm thời; không dùng lại
# chính sách này cho hệ thống cài đặt hoặc dữ liệu riêng tư.
#
# Hash mật khẩu đã được "nướng" vào /etc/shadow từ lúc build (pacman hook
# anios-live-user.hook), nên đăng nhập SDDM bằng tay không phụ thuộc service
# này có chạy thành công hay không. Bước dưới đây đặt lại mật khẩu như một
# lớp dự phòng (cũng đảm bảo sudo và hyprlock luôn dùng đúng mật khẩu).
password=1111
printf '%s:%s\n' "$user" "$password" | chpasswd || {
  echo "Could not set the live user's password; refusing to continue." >&2
  exit 1
}

install -d -m 0755 -o "$user" -g "$group" \
  "$home/Desktop" "$home/Documents" "$home/Downloads" "$home/Pictures" "$home/Videos" "$home/Games"
find "$home/Desktop" -maxdepth 1 -type f -name '*.desktop' -exec chmod +x {} +

# --- Tối ưu dung lượng lớp ghi (cowspace) & pacman cho phiên Live ----------
# Trong phiên live, `/` nằm trên overlayfs có lớp ghi là tmpfs `/run/archiso/cowspace`.
# Nếu người dùng chạy `pacman -Syu` hoặc `yay -Syu`, pacman vừa tải hàng GB file
# `.pkg.tar.zst` vào `/var/cache/pacman/pkg` (cũng nằm trên cowspace) vừa giải nén
# đè lên `/usr`, rất dễ làm đầy cowspace hoặc cạn inode giữa chừng với lỗi:
#   "error: could not extract /usr/share/locale/... (Write failed)"
if [[ -d /run/archiso/cowspace ]] && grep -q ' /run/archiso/cowspace ' /proc/mounts 2>/dev/null; then
  # Mở rộng cowspace tối thiểu 10G (hoặc 80% RAM nếu máy nhiều RAM) và bỏ giới hạn
  # inode (nr_inodes=0); trang nguội sẽ được nén sang zram.
  mem_kib="$(awk '/^MemTotal:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)"
  cow_mib=$(( mem_kib * 80 / 100 / 1024 ))
  if (( cow_mib < 10240 )); then
    cow_mib=10240
  fi
  mount -o "remount,size=${cow_mib}M,nr_inodes=0" /run/archiso/cowspace 2>/dev/null || true
  mount -o "remount,size=${cow_mib}M,nr_inodes=0" /tmp 2>/dev/null || true

  # Đẩy thư mục cache tải gói của pacman sang /tmp (tmpfs riêng) để file .pkg.tar.zst
  # không chiếm trực tiếp không gian giải nén của `/` (cowspace), đồng thời bỏ qua
  # nâng cấp kernel/firmware (vô tác dụng trên USB live mà còn xoá mất module của
  # kernel đang chạy) và không giải nén manpage/doc/locale ngoại ngữ không dùng.
  install -d -m 0755 /tmp/pacman-pkg-cache
  if [[ -f /etc/pacman.conf ]] && ! grep -qF '# anios-live-pacman-tuning' /etc/pacman.conf; then
    sed -i '/^\[options\]/a \
# anios-live-pacman-tuning\
CacheDir = /tmp/pacman-pkg-cache/\
IgnorePkg = linux-zen linux-zen-headers linux-firmware linux-firmware-whence\
NoExtract = usr/share/doc/* usr/share/gtk-doc/* usr/share/help/* usr/share/info/* usr/share/man/* usr/share/locale/* !usr/share/locale/en* !usr/share/locale/vi* !usr/share/locale/locale.alias' /etc/pacman.conf || true
  fi
fi
